rules_version = '2';

// Who may read and write the auctions.
//
// There is no login screen yet. Every browser signs in silently with an
// anonymous identity; the browser that created an auction is its owner.
//   - The owner can create, change and delete the auction.
//   - Anyone who has the auction's link (its long random id) can watch it.
//   - Nobody can browse or search for other people's auctions.
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    match /auctions/{auctionId} {
      function owns() {
        return signedIn() && resource.data.ownerId == request.auth.uid;
      }
      function validRecord() {
        return request.resource.data.keys().hasOnly(['ownerId', 'name', 'updatedAt', 'data'])
          && request.resource.data.ownerId == request.auth.uid
          && request.resource.data.name is string
          && request.resource.data.updatedAt is number
          && request.resource.data.data is string;
      }

      // Opening one auction by its link.
      allow get: if true;
      // Listing: only your own auctions.
      allow list: if owns();
      allow create: if signedIn() && validRecord();
      allow update: if owns() && validRecord();
      allow delete: if owns();

      // Player photos and team logos, one small record each.
      match /photos/{photoId} {
        function ownsAuction() {
          return signedIn()
            && get(/databases/$(database)/documents/auctions/$(auctionId)).data.ownerId == request.auth.uid;
        }
        allow read: if true;
        allow create, update: if ownsAuction()
          && request.resource.data.keys().hasOnly(['data'])
          && request.resource.data.data is string
          && request.resource.data.data.size() < 300000;
        allow delete: if ownsAuction();
      }
    }

    // Everything else is closed.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
